---
import { FontAwesomeIcon } from "astro-fontawesome";
import { faBars, faGlobe, faChevronDown } from "@fortawesome/free-solid-svg-icons";
import logo from "../assets/icon.webp";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { getLocale } from "astro-i18n-aut";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

function langHref(targetLang: Lang) {
  let base = currentPath.replace(/^\/(en|id)/, "");
  if (base.length > 1 && base.endsWith("/")) {
    base = base.slice(0, -1);
  }
  base = base || "/";
  
  if (targetLang === "en") return base;
  return `/id${base === "/" ? "" : base}`;
}

function navHref(path: string) {
  const target = locale === "id" ? `/id${path}` : path;
  return target || "/";
}
---

<header
  class="navbar bg-primary text-primary-content sticky top-0 z-50 font-sans shadow-md"
>
  <div class="flex-1">
    <a href={navHref("")} class="inline-flex items-center px-4 text-xl">
      <img
        src={logo.src}
        alt="PT. PROMATCON TEPATGUNA Logo"
        class="h-8 w-auto rounded bg-white p-1"
      />
      <span class="ms-3 font-bold tracking-wide text-sm sm:text-base"
        ><span class="text-secondary">PT. PROMATCON</span> TEPATGUNA</span
      >
    </a>
  </div>
  <div class="hidden flex-none items-center lg:flex">
    <ul class="menu menu-horizontal text-primary-content px-1 font-medium">
      <li><a href={navHref("")}>{t("nav.home")}</a></li>
      <li><a href={navHref("/about")}>{t("nav.about")}</a></li>
      <li><a href={navHref("/products-services")}>{t("nav.products")}</a></li>
      <li><a href={navHref("/experience")}>{t("nav.experience")}</a></li>
    </ul>

    <!-- Language Switcher Desktop -->
    <div class="dropdown dropdown-end mx-2">
      <div
        tabindex="0"
        role="button"
        class="btn btn-ghost text-primary-content hover:bg-primary-content hover:text-primary gap-1"
      >
        <FontAwesomeIcon icon={faGlobe} class="h-4 w-4" />
        {locale === "id" ? "ID" : "EN"}
        <FontAwesomeIcon icon={faChevronDown} class="h-3 w-3" />
      </div>
      <ul
        tabindex="0"
        class="menu dropdown-content bg-base-100 text-base-content hover:text-primary rounded-box z-50 mt-2 w-52 p-2 shadow-lg"
      >
        <li>
          <a href={langHref("en")} class={locale === "en" ? "active" : ""}>
            🇬🇧 English
          </a>
        </li>
        <li>
          <a href={langHref("id")} class={locale === "id" ? "active" : ""}>
            🇮🇩 Bahasa Indonesia
          </a>
        </li>
      </ul>
    </div>

    <a
      href={navHref("/contact")}
      class="btn btn-secondary text-secondary-content ml-2 font-semibold"
      >{t("nav.contact")}</a
    >
  </div>
  <div class="dropdown dropdown-end flex-none lg:hidden">
    <div
      tabindex="0"
      role="button"
      class="btn btn-square bg-transparent border-none shadow-none text-primary-content hover:bg-black/10"
    >
      <FontAwesomeIcon icon={faBars} class="h-6 w-6" />
    </div>
    <ul
      tabindex="0"
      class="menu dropdown-content bg-primary text-primary-content fixed top-16 left-0 w-full z-50 p-4 shadow-xl text-lg font-medium rounded-b-box"
    >
      <li><a href={navHref("")}>{t("nav.home")}</a></li>
      <li><a href={navHref("/about")}>{t("nav.about")}</a></li>
      <li><a href={navHref("/products-services")}>{t("nav.products")}</a></li>
      <li><a href={navHref("/experience")}>{t("nav.experience")}</a></li>
      <li><a href={navHref("/contact")}>{t("nav.contact")}</a></li>
      <div class="divider border-primary-content/20 my-1"></div>
      <li>
        <a href={langHref("en")} class={locale === "en" ? "font-bold" : ""}>🇬🇧 English</a>
      </li>
      <li>
        <a href={langHref("id")} class={locale === "id" ? "font-bold" : ""}>🇮🇩 Bahasa Indonesia</a>
      </li>
    </ul>
  </div>
</header>
