---
import { FontAwesomeIcon } from "astro-fontawesome";
import { faBars } from "@fortawesome/free-solid-svg-icons";
import logo from "../assets/icon.webp";
---

<header
  class="navbar bg-primary text-primary-content sticky top-0 z-50 font-sans shadow-md"
>
  <div class="flex-1">
    <a href="/" class="inline-flex items-center px-4 text-xl">
      <img
        src={logo.src}
        alt="PT. PROMATCON TEPATGUNA Logo"
        class="h-8 w-auto rounded bg-white p-1"
      />
      <span class="ms-3 hidden font-bold tracking-wide sm:block"
        ><span class="text-secondary">PT. PROMATCON</span> TEPATGUNA</span
      >
    </a>
  </div>
  <div class="hidden flex-none items-center md:flex">
    <ul class="menu menu-horizontal text-primary-content px-1 font-medium">
      <li><a href="/">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/products-services">Products & Services</a></li>
      <li><a href="/experience">Experience</a></li>
      <li><a href="/contact">Contact Us</a></li>
    </ul>
    <a
      href="/contact"
      class="btn btn-secondary text-secondary-content ml-4 font-semibold"
      >Contact Us</a
    >
  </div>
  <div class="dropdown dropdown-end flex-none md:hidden">
    <div
      tabindex="0"
      role="button"
      class="btn btn-ghost btn-circle text-primary-content"
    >
      <FontAwesomeIcon icon={faBars} class="h-5 w-5" />
    </div>
    <ul
      tabindex="0"
      class="menu menu-sm dropdown-content bg-base-100 rounded-box text-base-content z-[1] mt-3 w-52 p-2 font-medium shadow"
    >
      <li><a href="/">Home</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/products-services">Products & Services</a></li>
      <li><a href="/experience">Experience</a></li>
      <li><a href="/contact">Contact Us</a></li>
    </ul>
  </div>
</header>
