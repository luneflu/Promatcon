---
import { FontAwesomeIcon } from "astro-fontawesome";
import { faBars } from "@fortawesome/free-solid-svg-icons";
import logo from "../assets/icon.webp";
---

<header
  class="navbar bg-primary text-primary-content sticky top-0 z-50 shadow-md"
>
  <div class="flex-1">
    <a href="#" class="inline-flex items-center px-4 text-xl">
      <img
        src={logo.src}
        alt="PT. PROMATCON TEPATGUNA Logo"
        class="h-8 w-auto bg-white p-1 rounded"
      />
      <span class="hidden sm:block ms-3 tracking-wide font-bold"
        ><span class="text-secondary">PT. PROMATCON</span> TEPATGUNA</span
      >
    </a>
  </div>
  <div class="flex-none hidden md:flex items-center">
    <ul class="menu menu-horizontal px-1">
      <li><a href="#">Home</a></li>
      <li><a href="#">About Us</a></li>
      <li><a href="#">Products & Services</a></li>
      <li><a href="#">Experience</a></li>
    </ul>
    <a href="#" class="btn btn-secondary ml-4">Contact Us</a>
  </div>
  <div class="flex-none md:hidden dropdown dropdown-end">
    <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
      <FontAwesomeIcon icon={faBars} class="h-5 w-5" />
    </div>
    <ul
      tabindex="0"
      class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52 text-base-content"
    >
      <li><a href="#">Home</a></li>
      <li><a href="#">About Us</a></li>
      <li><a href="#">Products & Services</a></li>
      <li><a href="#">Experience</a></li>
      <li><a href="#">Contact Us</a></li>
    </ul>
  </div>
</header>
