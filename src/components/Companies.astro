---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { getLocale } from "astro-i18n-aut";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);

// Import all webp and svg files from the companies directory
const imageFiles = import.meta.glob('/public/images/companies/*.{webp,svg}', { eager: true });
const files = Object.keys(imageFiles).map(path => path.replace('/public', ''));
---

<section class="py-12 bg-base-100 overflow-hidden border-y border-base-200">
  <div class="container mx-auto px-4 mb-8">
    <h2 class="text-2xl font-bold text-center text-base-content uppercase tracking-wider">{t('companies.title')}</h2>
    <div class="mt-3 flex gap-1 items-center justify-center">
      <div class="bg-primary h-1 w-12"></div>
      <div class="bg-accent h-1 w-40"></div>
    </div>
  </div>
  <div class="relative w-full flex overflow-hidden group mask mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <div class="flex animate-scroll group-hover:[animation-play-state:paused] whitespace-nowrap min-w-max">
      {files.map((file: string) => (
        <div class="w-40 md:w-52 h-20 mx-4 md:mx-8 flex items-center justify-center">
          <img 
            src={file} 
            alt={file.split('/').pop()?.split('.')[0]} 
            loading="lazy" 
            decoding="async" 
            class="max-w-full max-h-full object-contain" 
            width="200"
            height="80"
          />
        </div>
      ))}
      {files.map((file: string) => (
        <div class="w-40 md:w-52 h-20 mx-4 md:mx-8 flex items-center justify-center">
          <img 
            src={file} 
            alt={file.split('/').pop()?.split('.')[0]} 
            loading="lazy" 
            decoding="async" 
            class="max-w-full max-h-full object-contain" 
            width="200"
            height="80"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .animate-scroll {
    animation: scroll 40s linear infinite;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
</style>
