---
import logo from "../assets/icon.webp";
---

<footer
  class="footer bg-primary text-primary-content border-accent border-t-4 p-10"
>
  <aside>
    <div class="mb-2 flex w-fit items-center gap-3 rounded bg-white p-2">
      <img src={logo.src} alt="Promatcon Logo" class="h-8" />
      <span class="text-primary font-bold tracking-wide"
        ><span class="text-secondary">PT. PROMATCON</span> TEPATGUNA</span
      >
    </div>
    <p class="text-primary-content/80 leading-relaxed">
      Delivering end-to-end industrial EPCI and engineering solutions<br />
      with a commitment to structural integrity and professional competence.
    </p>
  </aside>
</footer>
<footer
  class="footer footer-center bg-primary text-primary-content/70 border-primary-content/10 border-t p-4 text-xs"
>
  <aside>
    <p>
      &copy; {new Date().getFullYear()} PT. PROMATCON TEPATGUNA. All rights reserved.
    </p>
  </aside>
</footer>
