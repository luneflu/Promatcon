---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faCheckCircle,
  faWrench,
  faFilePdf,
  faDownload,
} from "@fortawesome/free-solid-svg-icons";
import introductionImage from "../assets/introduction.webp";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { getLocale } from "astro-i18n-aut";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);
---

<section class="bg-base-100 border-base-300 border-y py-12">
  <div class="container mx-auto max-w-7xl px-4 md:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="space-y-6">
        <h2 class="text-base-content text-3xl font-bold md:text-4xl">
          {t("intro.heading")}
        </h2>
        <div class="mt-2 flex gap-1">
          <div class="bg-primary h-1 w-12"></div>
          <div class="bg-accent h-1 w-40"></div>
        </div>
        <div class="text-base-content/80 space-y-4 text-lg leading-relaxed text-justify">
          <p>{t("intro.p1")}</p>
          <p>{t("intro.p2")}</p>
          <p>{t("intro.p3")}</p>
        </div>

        <div class="grid grid-cols-1 gap-6 pt-6 sm:grid-cols-2">
          <div class="card bg-base-200 border-base-300 border">
            <div class="card-body p-6">
              <div class="text-primary mb-2 flex items-center gap-3 font-bold">
                <div class="bg-secondary/10 text-secondary rounded p-2">
                  <FontAwesomeIcon icon={faCheckCircle} class="h-5 w-5" />
                </div>
                {t("intro.card1.title")}
              </div>
              <p class="text-base-content/70 text-sm">
                {t("intro.card1.desc")}
              </p>
            </div>
          </div>
          <div class="card bg-base-200 border-base-300 border">
            <div class="card-body p-6">
              <div class="text-primary mb-2 flex items-center gap-3 font-bold">
                <div class="bg-secondary/10 text-secondary rounded p-2">
                  <FontAwesomeIcon icon={faWrench} class="h-5 w-5" />
                </div>
                {t("intro.card2.title")}
              </div>
              <p class="text-base-content/70 text-sm text-justify">
                {t("intro.card2.desc")}
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="rounded-box border-base-300 relative h-[500px] overflow-hidden border shadow-xl"
      >
        <img
          src={introductionImage.src}
          alt="Industrial pipes and valves"
          class="h-full w-full object-cover"
        />
        <div class="bg-secondary/10 absolute inset-0 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="card bg-base-200 border-base-300 mt-12 border p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start md:items-center gap-4">
          <div class="bg-primary/10 text-primary rounded p-3 shrink-0">
            <FontAwesomeIcon icon={faFilePdf} class="h-7 w-7" />
          </div>
          <div>
            <h3 class="text-base-content font-bold text-lg md:text-xl">
              {t("intro.download.title")}
            </h3>
            <p class="text-base-content/70 text-sm md:text-base">
              {t("intro.download.desc")}
            </p>
          </div>
        </div>
        <a
          href="/PT PROMATCON TEPATGUNA Company Profile & Experience List.pdf"
          download="PT PROMATCON TEPATGUNA Company Profile & Experience List.pdf"
          class="btn btn-primary shrink-0 gap-2"
          aria-label="Download Company Profile PDF"
        >
          <FontAwesomeIcon icon={faDownload} class="h-4 w-4" />
          {t("intro.download.btn")}
        </a>
      </div>
    </div>
  </div>
</section>
