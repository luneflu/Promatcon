---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faEye,
  faBullseye,
  faCheckCircle,
} from "@fortawesome/free-solid-svg-icons";
---

<section
  class="bg-primary text-primary-content rounded-box relative overflow-hidden p-8 shadow-xl md:p-12"
>
  <div class="relative z-10 grid grid-cols-1 gap-12 md:grid-cols-2">
    <!-- Vision -->
    <div class="flex flex-col">
      <div class="mb-6 flex items-center gap-4">
        <div class="bg-base-100 text-primary rounded-full p-4 shadow-sm">
          <FontAwesomeIcon icon={faEye} class="h-8 w-8" />
        </div>
        <h2 class="m-0 text-3xl font-bold tracking-tight">Vision</h2>
      </div>
      <p class="text-primary-content/90 text-lg leading-relaxed">
        To become a leading company in providing support and services to major
        players in the oil and gas & renewable energy (geothermal) industries in
        Indonesia.
      </p>
    </div>

    <!-- Mission -->
    <div class="flex flex-col">
      <div class="mb-6 flex items-center gap-4">
        <div
          class="bg-secondary text-secondary-content rounded-full p-4 shadow-sm"
        >
          <FontAwesomeIcon icon={faBullseye} class="h-8 w-8" />
        </div>
        <h2 class="m-0 text-3xl font-bold tracking-tight">Mission</h2>
      </div>
      <ul class="text-primary-content/90 space-y-4 text-lg">
        <li class="flex items-start gap-3">
          <FontAwesomeIcon
            icon={faCheckCircle}
            class="text-secondary mt-1 h-6 w-6 shrink-0"
          />
          <span class="leading-relaxed"
            >The company designs, develops, supplies and supports the oil, gas &
            renewable energy (geothermal) businesses in Indonesia.</span
          >
        </li>
        <li class="flex items-start gap-3">
          <FontAwesomeIcon
            icon={faCheckCircle}
            class="text-secondary mt-1 h-6 w-6 shrink-0"
          />
          <span class="leading-relaxed"
            >Meet the highest performance standards set by customers to fulfill
            the quality of work required to provide customer satisfaction.</span
          >
        </li>
        <li class="flex items-start gap-3">
          <FontAwesomeIcon
            icon={faCheckCircle}
            class="text-secondary mt-1 h-6 w-6 shrink-0"
          />
          <span class="leading-relaxed"
            >We promote Quality, Health, Safety, Environment and Reliability
            on-time delivery and delivery within budget as the highest value in
            our operations.</span
          >
        </li>
      </ul>
    </div>
  </div>
</section>
