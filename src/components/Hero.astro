---
import type { UIKey, Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { getLocale } from "astro-i18n-aut";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);
---

<section
  class="hero bg-primary-container text-primary-content relative min-h-[600px]"
>
  <div class="absolute inset-0 z-0 bg-black">
    <img
      src="/images/Pressure Vessel/Dehydration Unit Package - Bambu Besar 002.webp"
      alt="Offshore oil rig at sunset"
      class="h-full w-full object-cover opacity-50"
    />
  </div>

  <div
    class="hero-content relative z-10 w-full max-w-7xl justify-start text-left"
  >
    <div class="max-w-3xl py-20">
      <span
        class="badge badge-accent mb-4 p-3 text-xs font-bold tracking-widest uppercase"
        >{t("hero.badge")}</span
      >
      <h1 class="mb-6 text-4xl leading-tight font-bold md:text-5xl lg:text-6xl">
        {t("hero.title")}
      </h1>
      <p
        class="text-primary-content/80 mb-10 max-w-2xl text-lg leading-relaxed md:text-xl"
      >
        {t("hero.desc")}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={locale === "id" ? "/id/about" : "/about"} class="btn btn-primary text-primary-content font-bold">
          {t("hero.cta.primary")}
        </a>
        <a
          href={locale === "id" ? "/id/experience" : "/experience"}
          class="btn btn-outline hover:bg-primary hover:text-primary-content hover:border-primary border-white font-semibold text-white"
        >
          {t("hero.cta.secondary")}
        </a>
      </div>
    </div>
  </div>
</section>
