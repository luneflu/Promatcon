---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faCogs,
  faNetworkWired,
  faHardHat,
  faServer,
  faProjectDiagram,
  faIndustry,
  faCheck,
} from "@fortawesome/free-solid-svg-icons";
---

<section id="services" class="py-24 bg-base-200">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">
        Core Business Areas
      </h2>
      <p class="text-base-content/80 text-lg">
        Precision engineering and robust infrastructure solutions tailored for
        the demanding environments of the energy sector.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Service Card 1 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faCogs} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">
            Comprehensive & Operational Services
          </h3>
          <ul class="space-y-3 text-base-content/80 text-sm">
            <li class="flex items-start gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-5 h-5 text-accent shrink-0 mt-0.5"
              />
              <span
                ><strong>Comprehensive Package:</strong> Concept to design, manufacturing,
                transportation, installation, commissioning, and operator training.</span
              >
            </li>
            <li class="flex items-start gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-5 h-5 text-accent shrink-0 mt-0.5"
              />
              <span
                ><strong>Operational Services:</strong> Planning, Procurement, Fabrication,
                Installation, O&M, QA/QC.</span
              >
            </li>
          </ul>
        </div>
      </div>

      <!-- Service Card 2 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faProjectDiagram} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">Engineering Services</h3>
          <ul class="space-y-3 text-base-content/80 text-sm list-disc pl-5">
            <li>Basic Design & Detailed Engineering</li>
            <li>System Design & Cost Estimation</li>
            <li>Hysym/Hysys/Pipesym Calculations</li>
            <li>Turbo Control & Project Management</li>
          </ul>
        </div>
      </div>

      <!-- Service Card 3 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faHardHat} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">
            EPCI & Civil Construction
          </h3>
          <ul class="space-y-3 text-base-content/80 text-sm">
            <li class="flex items-start gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-5 h-5 text-accent shrink-0 mt-0.5"
              />
              <span
                ><strong>EPCI Detail:</strong> Surface Facilities, Dehydration, EOR,
                Gas Compressors, Pipelines, Tanks, Water Treatment, etc.</span
              >
            </li>
            <li class="flex items-start gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-5 h-5 text-accent shrink-0 mt-0.5"
              />
              <span
                ><strong>Civil Construction:</strong> Jetty, Dredging, Site Prep.</span
              >
            </li>
          </ul>
        </div>
      </div>

      <!-- Service Card 4 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faServer} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">Compression System</h3>
          <ul class="space-y-3 text-base-content/80 text-sm list-disc pl-5">
            <li>Reciprocating/Centrifugal for Natural Gas</li>
            <li>Booster, Transfer, VRU</li>
            <li>Flare/Fuel Gas packages</li>
          </ul>
        </div>
      </div>

      <!-- Service Card 5 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faNetworkWired} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">Integration Systems</h3>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >Turbine Control</span
            >
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >Fire Alarm</span
            >
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >VSD</span
            >
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >Power Distribution</span
            >
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >Pneumatic</span
            >
            <span class="badge badge-secondary text-xs font-semibold py-3 px-3"
              >Scada</span
            >
          </div>
          <p class="text-base-content/80 text-sm">
            Advanced comprehensive control and monitoring solutions.
          </p>
        </div>
      </div>

      <!-- Service Card 6 -->
      <div
        class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow border border-base-300"
      >
        <div class="card-body">
          <div
            class="h-12 w-12 bg-primary/10 text-primary rounded flex items-center justify-center mb-4"
          >
            <FontAwesomeIcon icon={faIndustry} class="w-6 h-6" />
          </div>
          <h3 class="card-title text-primary mb-2">Fabrication</h3>
          <p class="text-base-content/80 text-sm mb-3">
            Oil & Gas Treatment Fabrication including:
          </p>
          <ul class="space-y-2 text-base-content/80 text-sm mb-4">
            <li class="flex items-center gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-4 h-4 text-accent shrink-0"
              /> Dehydration, Separators, Scrubbers
            </li>
            <li class="flex items-center gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-4 h-4 text-accent shrink-0"
              /> FWKO, Filtration, Chemical Injection
            </li>
            <li class="flex items-center gap-2">
              <FontAwesomeIcon
                icon={faCheck}
                class="w-4 h-4 text-accent shrink-0"
              /> Water Treatment (CPI, Flotation, RO)
            </li>
          </ul>
          <div class="divider mt-2 mb-2"></div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <h4 class="font-bold text-sm text-primary mb-1">Rental</h4>
              <p class="text-xs text-base-content/70">
                EOR, Compressors, Water Treatment, Desander, Chemical Tanks.
              </p>
            </div>
            <div>
              <h4 class="font-bold text-sm text-primary mb-1">Trading</h4>
              <p class="text-xs text-base-content/70">
                Pipes, Fittings, TEG/MEG.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
