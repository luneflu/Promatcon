---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faHistory,
  faChartLine,
  faHardHat,
  faCogs,
  faIndustry,
  faBoxOpen,
} from "@fortawesome/free-solid-svg-icons";
import "../styles/global.css";

const coreTeams = [
  { title: "Construction Team", icon: faHardHat },
  { title: "Engineering Team", icon: faCogs },
  { title: "Fabrication Team", icon: faIndustry },
  { title: "Procurement Team", icon: faBoxOpen },
];

const operations = [
  {
    title: "Up Stream",
    subtitle: "Exploration & Production",
    items: [
      "Offshore Exploration",
      "Onshore Exploration",
      "Surface Facilities",
    ],
  },
  {
    title: "Mid Stream",
    subtitle: "Transport & Storage",
    items: [
      "Oil and Gas Pipe Transfer Lines",
      "FPSO (Floating Production Storage)",
      "Tankers",
    ],
  },
  {
    title: "Down Stream",
    subtitle: "Processing & Refining",
    items: ["Crude Oil Refining Process", "Gas Processing", "Petrochemical"],
  },
];
---

<script>
  import ApexTree from "apextree";
  const data = {
    id: "root",
    name: "President Director",
    data: { name: "President Director", role: "Adi Priyadi", theme: "primary" },
    children: [
      {
        id: "1",
        name: "Engineering Director",
        data: {
          name: "Engineering Director",
          role: "Ben Gadjuli",
          theme: "secondary",
        },
        children: [
          {
            id: "1-1",
            name: "Engineering Manager",
            data: { name: "Engineering Manager", role: "Felix Trinaksa" },
            children: [],
          },
        ],
      },
      {
        id: "2",
        name: "Operation Director",
        data: {
          name: "Operation Director",
          role: "Gunarso Sudoro",
          theme: "secondary",
        },
        children: [
          {
            id: "2-1",
            name: "Procurement Manager",
            data: { name: "Procurement Manager", role: "David Martandi" },
            children: [],
          },
          {
            id: "2-2",
            name: "H R D",
            data: { name: "H R D", role: "Suwito" },
            children: [],
          },
        ],
      },
      {
        id: "3",
        name: "Finance Director",
        data: {
          name: "Finance Director",
          role: "Dian Hariyani",
          theme: "secondary",
        },
        children: [
          {
            id: "3-1",
            name: "Finance Manager",
            data: { name: "Finance Manager", role: "Ventje" },
            children: [],
          },
          {
            id: "3-2",
            name: "Marketing Manager",
            data: { name: "Marketing Manager", role: "", theme: "accent" },
            children: [
              {
                id: "m-1",
                name: "Compressor Division",
                data: { name: "Compressor Division", role: "Adi Priyanto" },
                children: [],
              },
              {
                id: "m-2",
                name: "Process Division",
                data: { name: "Process Division", role: "Budi Nainggolan" },
                children: [],
              },
              {
                id: "m-3",
                name: "Chemical Division",
                data: { name: "Chemical Division", role: "Hendro Rahardjo" },
                children: [],
              },
              {
                id: "m-4",
                name: "Civil Division",
                data: { name: "Civil Division", role: "Thomson & Darmawan" },
                children: [],
              },
              {
                id: "m-5",
                name: "Pipe and Fittings Trading",
                data: { name: "Pipe and Fittings Trading", role: "Singgih" },
                children: [],
              },
              {
                id: "m-6",
                name: "Control System Integration",
                data: {
                  name: "Control System Integration",
                  role: "Anhar Djamal",
                },
                children: [],
              },
            ],
          },
        ],
      },
    ],
  };

  const options = {
    width: "100%",
    height: "600px",
    nodeWidth: 200,
    nodeHeight: 60,
    childrenSpacing: 80,
    siblingSpacing: 30,
    direction: "top",
    contentKey: "data",
    groupLeafNodes: true,
    groupLeafNodesSpacing: 15,
    nodeTemplate: (content) => {
      let bg = "oklch(var(--b1))";
      let border = "oklch(var(--b3))";
      let nameColor = "oklch(var(--p))";
      let roleColor = "oklch(var(--bc))";

      if (content.theme === "primary") {
        bg = "oklch(var(--p))";
        border = "oklch(var(--p))";
        nameColor = "oklch(var(--pc))";
        roleColor = "oklch(var(--pc))";
      } else if (content.theme === "secondary") {
        bg = "oklch(var(--s))";
        border = "oklch(var(--s))";
        nameColor = "oklch(var(--sc))";
        roleColor = "oklch(var(--sc))";
      } else if (content.theme === "accent") {
        bg = "oklch(var(--a))";
        border = "oklch(var(--a))";
        nameColor = "oklch(var(--ac))";
        roleColor = "oklch(var(--ac))";
      }

      return `<div style='background: ${bg}; border: 1px solid ${border}; border-radius: var(--rounded-box, 1rem); padding: 0.75rem; text-align: center; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center;'>
          <p style='margin: 0 0 0.25rem 0; font-size: 0.75rem; font-weight: bold; color: ${nameColor};'>${content.name || ""}</p>
          <p style='margin: 0; font-size: 0.875rem; color: ${roleColor}; opacity: 0.9;'>${content.role || ""}</p>
        </div>`;
    },
    enableExpandCollapse: true,
  };

  document.addEventListener("DOMContentLoaded", () => {
    const el = document.getElementById("org-tree");
    if (el) {
      const TreeConstructor =
        typeof ApexTree === "function" ? ApexTree : ApexTree.default;
      const tree = new TreeConstructor(el, options);
      const graph = tree.render(data);

      // Force zoom in slightly if the auto-fit zoomed out too much
      setTimeout(() => {
        graph.fitScreen();
      }, 100);

      // Remove watermark element
      setTimeout(() => {
        const watermark = document.querySelector("[data-apexcharts-watermark]");
        if (watermark) watermark.remove();
      }, 300);
    }
  });
</script>

<Layout title="About Us - PT. PROMATCON TEPATGUNA">
  <Header />
  <main class="space-y-16 py-12 px-4 sm:px-8 max-w-7xl mx-auto">
    <!-- History & Evolution Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div
        class="card bg-base-100 border border-base-300 shadow-sm p-6 flex flex-col justify-center"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="p-3 bg-primary/10 rounded-full text-primary">
            <FontAwesomeIcon icon={faHistory} class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-primary m-0">The Beginning</h2>
        </div>
        <p class="text-base-content/80">
          Established since 1990, starting only as Promatcon trading company,
          with main core in the sale of control equipment for pressure vessels,
          plates, pipes and fittings and valves.
        </p>
      </div>
      <div
        class="card bg-base-100 border border-secondary/30 shadow-sm p-6 flex flex-col justify-center relative overflow-hidden"
      >
        <div class="flex items-center gap-3 mb-4">
          <div class="p-3 bg-secondary/10 rounded-full text-secondary">
            <FontAwesomeIcon icon={faChartLine} class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-secondary m-0">The Evolution</h2>
        </div>
        <p class="text-base-content/80">
          Presently, Promatcon has become a leading multinational company
          specializing in Engineering, Procurement Construction and Instalation
          EPCI.
        </p>
      </div>
    </section>

    <!-- Core Teams Section -->
    <section class="bg-base-200 p-8 rounded-box">
      <div class="mb-6">
        <h2 class="text-3xl font-bold text-base-content">
          Our Specialized Teams
        </h2>
        <div class="w-16 h-1 bg-secondary mt-2"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          coreTeams.map((team) => (
            <div class="card bg-base-100 border border-base-300 p-6 flex flex-col justify-between hover:border-secondary transition-colors group">
              <div class="flex justify-between items-start mb-4">
                <div class="text-base-content/40 group-hover:text-secondary transition-colors">
                  <FontAwesomeIcon icon={team.icon} class="w-8 h-8" />
                </div>
                <span class="badge badge-secondary badge-sm">
                  Core Function
                </span>
              </div>
              <h3 class="text-xl font-bold text-base-content">{team.title}</h3>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Operational Focus Section -->
    <section class="space-y-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-base-content">Operational Focus</h2>
        <p class="text-base-content/70 mt-2 max-w-2xl mx-auto">
          Specialized capabilities in Oil and Gas and Petrochemical equipments
          across the entire value chain.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          operations.map((op) => (
            <div class="card bg-base-100 border border-base-300 border-t-4 border-t-accent shadow-sm p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-bold text-primary">{op.title}</h3>
                <p class="text-sm font-semibold text-secondary mb-4">
                  {op.subtitle}
                </p>
                <ul class="space-y-2 text-base-content/80">
                  {op.items.map((item) => (
                    <li class="flex items-center gap-2">
                      <span class="text-secondary font-bold">✓</span> {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Organizational Structure Section -->
    <section class="bg-base-200 p-8 rounded-box">
      <div class="mb-8 text-center">
        <h2 class="text-3xl font-bold text-base-content">
          Organizational Structure
        </h2>
        <div class="w-16 h-1 bg-secondary mx-auto mt-2"></div>
      </div>
      <div id="org-tree" class="w-full"></div>
    </section>
  </main>
  <Footer />
</Layout>
