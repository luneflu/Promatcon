---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VisionMission from "../components/VisionMission.astro";
import OrgTree from "../components/OrgTree.svelte";
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faHistory,
  faChartLine,
  faHardHat,
  faCogs,
  faIndustry,
  faBoxOpen,
} from "@fortawesome/free-solid-svg-icons";
import "../styles/global.css";

const coreTeams = [
  { title: "Construction Team", icon: faHardHat },
  { title: "Engineering Team", icon: faCogs },
  { title: "Fabrication Team", icon: faIndustry },
  { title: "Procurement Team", icon: faBoxOpen },
];

const operations = [
  {
    title: "Up Stream",
    subtitle: "Exploration & Production",
    items: [
      "Offshore Exploration",
      "Onshore Exploration",
      "Surface Facilities",
    ],
  },
  {
    title: "Mid Stream",
    subtitle: "Transport & Storage",
    items: [
      "Oil and Gas Pipe Transfer Lines",
      "FPSO (Floating Production Storage)",
      "Tankers",
    ],
  },
  {
    title: "Down Stream",
    subtitle: "Processing & Refining",
    items: ["Crude Oil Refining Process", "Gas Processing", "Petrochemical"],
  },
];
---

<Layout title="About Us - PT. PROMATCON TEPATGUNA">
  <Header />
  <main class="mx-auto max-w-7xl space-y-16 px-4 py-12 sm:px-8">
    <!-- Page Header -->
    <div class="mb-10 text-center">
      <h1
        class="text-base-content mb-2 text-4xl font-semibold tracking-tight md:text-5xl"
      >
        About Us
      </h1>
      <p class="text-base-content/70 mx-auto max-w-2xl text-lg">
        A leading multinational company specializing in Engineering,
        Procurement, Construction and Installation (EPCI).
      </p>
    </div>

    <!-- History & Evolution Section -->
    <section class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <div
        class="card bg-base-100 border-base-300 flex flex-col justify-center border p-6 shadow-sm"
      >
        <div class="mb-4 flex items-center gap-3">
          <div class="bg-primary/10 text-primary rounded-full p-3">
            <FontAwesomeIcon icon={faHistory} class="h-6 w-6" />
          </div>
          <h2 class="text-primary m-0 text-2xl font-bold">The Beginning</h2>
        </div>
        <p class="text-base-content/80 leading-relaxed">
          Established since 1990, starting only as Promatcon trading company,
          with main core in the sale of control equipment for pressure vessels,
          plates, pipes and fittings and valves.
        </p>
      </div>
      <div
        class="card bg-base-100 border-base-300 relative flex flex-col justify-center overflow-hidden border p-6 shadow-sm"
      >
        <div class="mb-4 flex items-center gap-3">
          <div class="bg-secondary/10 text-secondary rounded-full p-3">
            <FontAwesomeIcon icon={faChartLine} class="h-6 w-6" />
          </div>
          <h2 class="text-secondary m-0 text-2xl font-bold">The Evolution</h2>
        </div>
        <p class="text-base-content/80 leading-relaxed">
          Presently, Promatcon has become a leading multinational company
          specializing in Engineering, Procurement Construction and Instalation
          EPCI.
        </p>
      </div>
    </section>

    <VisionMission />

    <!-- Core Teams Section -->
    <section class="bg-base-200 rounded-box border-base-300 border p-8">
      <div class="mb-6">
        <h2 class="text-base-content text-3xl font-bold">
          Our Specialized Teams
        </h2>
        <div class="mt-2 flex gap-1">
          <div class="bg-primary h-1 w-12"></div>
          <div class="bg-secondary h-1 w-40"></div>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          coreTeams.map((team) => (
            <div class="card bg-base-100 border-base-300 hover:border-secondary group flex flex-col justify-between border p-6 shadow-sm transition-colors">
              <div class="mb-4 flex items-start justify-between">
                <div class="text-base-content/60 group-hover:text-secondary transition-colors">
                  <FontAwesomeIcon icon={team.icon} class="h-8 w-8" />
                </div>
                <span class="badge badge-secondary badge-sm text-secondary-content font-bold">
                  Core Function
                </span>
              </div>
              <h3 class="text-base-content text-xl font-bold">{team.title}</h3>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Operational Focus Section -->
    <section class="space-y-8">
      <div class="text-center">
        <h2 class="text-base-content text-3xl font-bold">Operational Focus</h2>
        <p class="text-base-content/70 mx-auto mt-2 max-w-2xl">
          Specialized capabilities in Oil and Gas and Petrochemical equipments
          across the entire value chain.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          operations.map((op) => (
            <div class="card bg-base-100 border-base-300 border-t-secondary flex flex-col justify-between border border-t-4 p-6 shadow-sm">
              <div>
                <h3 class="text-primary text-2xl font-bold">{op.title}</h3>
                <p class="mb-4 text-sm font-medium">{op.subtitle}</p>
                <ul class="text-base-content/80 space-y-2">
                  {op.items.map((item) => (
                    <li class="flex items-center gap-2">
                      <span class="text-secondary font-bold">✓</span> {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Organizational Structure Section -->
    <section class="bg-base-200 rounded-box border-base-300 border p-8">
      <div class="mb-8 text-center">
        <h2 class="text-base-content text-3xl font-bold">
          Organizational Structure
        </h2>
        <div class="bg-secondary mx-auto mt-2 h-1 w-16"></div>
      </div>
      <OrgTree client:load />
    </section>
  </main>
  <Footer />
</Layout>
