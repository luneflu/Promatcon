---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { FontAwesomeIcon } from "astro-fontawesome";
import {
  faMapMarkerAlt,
  faPhone,
  faEnvelope,
  faGlobe,
} from "@fortawesome/free-solid-svg-icons";
import "../../styles/global.css";
import { useTranslations } from "../../i18n/ui";

const lang = "id";
const t = useTranslations(lang);

const keyContacts = [
  { name: "Gunarso Sudoro", email: "gunarso@promatcon.co.id" },
  { name: "Adi Priyanto", email: "adipriyanto@promatcon.co.id" },
  { name: "Ari Prima Andiono", email: "ariprima@promatcon.co.id" },
  { name: "Ardy Rahardjo", email: "ardy@promatcon.co.id" },
  { name: "David Martandi", email: "david@promatcon.co.id" },
  { name: "Hendro Rahardjo", email: "hendro-r@promatcon.co.id" },
  { name: "Chandra Kharisma", email: "chandra@promatcon.co.id" },
];
---

<Layout title="Hubungi Kami - PT. PROMATCON TEPATGUNA" lang={lang}>
  <Header lang={lang} currentPath={Astro.url.pathname} />
  <main class="w-full flex-grow">
    <!-- Hero Section -->
    <section
      class="bg-base-200 border-base-300 border-b px-4 py-12 text-center sm:px-8"
    >
      <div class="mx-auto max-w-4xl py-6">
        <h1
          class="text-base-content mb-2 text-4xl font-semibold tracking-tight md:text-5xl"
        >
          {t("contact.title")}
        </h1>
        <p class="text-base-content/70 text-lg">
          {t("contact.subtitle")}
        </p>
      </div>
    </section>

    <!-- Contact Details & Map Section -->
    <section class="mx-auto max-w-[1440px] px-4 py-12 sm:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <!-- Left Column: Details & Directory -->
        <div class="space-y-8">
          <!-- Office Details Card -->
          <div class="bg-base-100 border-base-300 rounded border p-6 shadow-sm">
            <h2
              class="text-base-content border-base-300 mb-6 border-b pb-2 text-xl font-bold"
            >
              {t("contact.locations")}
            </h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <FontAwesomeIcon
                  icon={faMapMarkerAlt}
                  class="text-primary mt-1 h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.head")}
                  </h3>
                  <p class="text-base-content text-sm leading-relaxed">
                    Jl. Kemanggisan Utama Raya No. J-7<br />
                    Jakarta 11480, Indonesia
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <FontAwesomeIcon
                  icon={faMapMarkerAlt}
                  class="text-primary mt-1 h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.correspondence")}
                  </h3>
                  <p class="text-base-content text-sm leading-relaxed">
                    Komplek Kebon Jeruk Baru Ruko B No. 7<br />
                    Kebon Jeruk, Jakarta Barat 11530
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <FontAwesomeIcon
                  icon={faMapMarkerAlt}
                  class="text-primary mt-1 h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.workshop")}
                  </h3>
                  <p class="text-base-content text-sm leading-relaxed">
                    Komplek Pergudangan Bajamas No. J-7<br />
                    Balaraja Barat - Banten 15610, Indonesia
                  </p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <FontAwesomeIcon
                  icon={faPhone}
                  class="text-primary h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.phone")}
                  </h3>
                  <p class="text-base-content text-sm">(021) 549 3555</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <FontAwesomeIcon
                  icon={faEnvelope}
                  class="text-primary h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.email")}
                  </h3>
                  <a
                    href="mailto:corporate@promatcon.co.id"
                    class="text-primary text-sm font-medium hover:underline"
                  >
                    corporate@promatcon.co.id
                  </a>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <FontAwesomeIcon
                  icon={faGlobe}
                  class="text-primary h-5 w-5 shrink-0"
                />
                <div>
                  <h3
                    class="text-base-content/60 text-xs font-semibold tracking-wider uppercase"
                  >
                    {t("contact.website")}
                  </h3>
                  <a
                    href="http://www.promatcon.co.id"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary text-sm font-medium hover:underline"
                  >
                    www.promatcon.co.id
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Persons Directory -->
          <div class="bg-base-100 border-base-300 rounded border p-6 shadow-sm">
            <h2
              class="text-base-content border-base-300 mb-6 border-b pb-2 text-xl font-bold"
            >
              {t("contact.keycontacts")}
            </h2>
            <ul class="space-y-3">
              {
                keyContacts.map((contact) => (
                  <li class="border-base-200 flex items-center justify-between border-b pb-3 last:border-0 last:pb-0">
                    <span class="text-base-content text-sm font-medium">
                      {contact.name}
                    </span>
                    <a
                      href={`mailto:${contact.email}`}
                      class="text-primary text-sm hover:underline"
                    >
                      {contact.email}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Right Column: Map -->
        <div
          class="bg-base-200 border-base-300 relative flex min-h-[400px] items-center justify-center overflow-hidden rounded border md:min-h-full"
        >
          <iframe
            title="Kantor Pusat"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.5581942058557!2d106.78837167538306!3d-6.1898242606454!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f69244c8b969%3A0xce6cf5eb786e25f5!2sJl.%20Kemanggisan%20Utama%20Raya%2C%20Kec.%20Palmerah%2C%20Kota%20Jakarta%20Barat%2C%20Daerah%20Khusus%20Ibukota%20Jakarta!5e0!3m2!1sid!2sid!4v1786654937617!5m2!1sid!2sid"
            class="absolute inset-0 h-full w-full border-0 opacity-90"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
