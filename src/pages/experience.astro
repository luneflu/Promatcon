---

<Layout title="Experience - PT. PROMATCON TEPATGUNA">
  <Header />
  <main class="mx-auto w-full max-w-[1440px] flex-grow px-4 py-12 md:px-16">
    <!-- Header Section -->
    <div class="mb-8 text-center">
      <h1
        class="text-base-content mb-2 text-4xl font-semibold tracking-tight md:text-5xl"
      >
        Experience & Certificates
      </h1>
      <p class="text-base-content/70 mx-auto max-w-3xl text-lg">
        A comprehensive record of our engineering and logistical project
        deliveries across major industrial sectors.
      </p>
    </div>

    <!-- Featured Project Cards Grid -->
    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        featuredProjects.map((project) => (
          <div class="bg-base-200/50 border-base-300 flex flex-col space-y-4 rounded-lg border p-6">
            <div class="flex items-center gap-4">
              <div class="bg-base-100 border-base-300 flex h-16 w-16 flex-shrink-0 items-center justify-center rounded border p-2">
                <img
                  src={project.logoUrl}
                  alt={`${project.client} Logo`}
                  class="h-full w-full object-contain"
                />
              </div>
              <h3 class="text-base-content text-xl font-bold">
                {project.client}
              </h3>
            </div>

            <div class="space-y-3 pt-2">
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Project Description
                </span>
                <p class="text-base-content/80 text-sm font-medium">
                  {project.description}
                </p>
              </div>
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Time and Point of Delivery
                </span>
                <p class="text-base-content/80 text-sm font-medium">
                  {project.delivery}
                </p>
              </div>
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Contract No
                </span>
                <p class="text-base-content/60 font-mono text-xs">
                  {project.contract}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Certificate Section using Swiper -->
    <CertificateGallery client:load />

    <!-- Main Container Card -->
    <div
      class="bg-base-100 border-base-300 space-y-8 rounded-lg border p-6 shadow-sm"
    >
      <!-- Tabs Navigation for Years -->
      <div class="border-base-300 w-full overflow-x-auto border-b">
        <div class="flex min-w-max space-x-2 pb-2 md:space-x-3">
          {
            years.map((year) => (
              <button
                class={`rounded-t-md px-4 py-2 text-sm font-semibold transition-colors ${
                  year === 2013
                    ? "bg-primary text-primary-content border-primary border-b-2 font-bold"
                    : "text-base-content/60 hover:bg-base-200 bg-transparent"
                }`}
              >
                {year}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Tab Content - 2013 Active Table -->
      <div>
        <div class="overflow-x-auto">
          <table class="table-zebra table w-full min-w-[800px]">
            <thead>
              <tr
                class="bg-base-200 text-base-content/80 border-base-300 border-b text-xs tracking-wider uppercase"
              >
                <th class="w-12">NO</th>
                <th class="w-28">Date</th>
                <th class="w-1/4">Client</th>
                <th class="w-48">PO/Contract No</th>
                <th>Subject</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              {
                historicalProjects2013.map((row) => (
                  <tr class="hover:bg-base-200/50">
                    <td class="font-mono text-xs opacity-60">{row.no}</td>
                    <td class="font-mono text-xs whitespace-nowrap">
                      {row.date}
                    </td>
                    <td class="text-base-content font-semibold">
                      {row.client}
                    </td>
                    <td class="text-base-content/70 font-mono text-xs">
                      {row.contract}
                    </td>
                    <td class="text-base-content/90">{row.subject}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
