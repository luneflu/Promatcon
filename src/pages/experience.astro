---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CertificateGallery from "../components/certificates/CertificateGallery.svelte";
import ExperienceTable from "../components/ExperienceTable.svelte";
import "../styles/global.css";
import experienceData from "../assets/experience_list.json";
import { useTranslations } from "../i18n/ui";

import { getLocale } from "astro-i18n-aut";
import type { Lang } from "../i18n/ui";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);

const featuredProjects = [
  {
    client: "PT Chevron Pacific Indonesia",
    logoUrl:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuCWjhfDi7KwG_GOvbBGM0NUz_FZPJikIRFXrWYJEvHtSsJTb-N2SHNlHoxdHCDosKkmjZ45ApzG7lTAr-iuueToMEI-iqmx7OGewmaclWDJwHSYEXEnSRpkrsHwUwoB4txsPpCJ429No4iG6fGq4AnnaOtwQnFF0v1pKgJW_A5yiBnF7fCzczDiiYUkttJJag4tSNJRx_-VXeBTd_a4RFrqLc6EcBmkp0p3UOfTeJnlPRH8g95Hm7VP0ejR_UXng9oJJQ",
    description: "Supply of 16 Unit Test Tank and 3 Unit Pressure Vessel",
    delivery: "Warehouse Bekasap",
    contract: "13441 R3WHBKS",
  },
  {
    client: "PT HESS (Indonesia-Pangkah) Ltd",
    logoUrl:
      "https://lh3.googleusercontent.com/aida-public/AB6AXuDiJ260-1Bgg5i0oZmg60xqp95kcGOeMY0lo1dVoqDuX9BYumEOu0SGIcER3LO4Ob6dW3NEdbfkIeUykdlo_bJgskkTZSXmGc09Zc_-AdubPtXQn3pDFjBfjck23W6aOM3BhHmQXoIymRJM3bUn3BcwXWZcN2Oi3yBNuzixsdrmcNdmoO24BcJgiu486YH3SKFNhlvX3JlC1vrwEyVzzTeyVW4_zkE-E-MXmTemsj9IK5RKJzXr9mRloSWKpKA_fqF4dQ",
    description: "Supply of Pressure Vessel",
    delivery: "DDU HIPL Warehouse Batam",
    contract: "4500190954",
  },
];
---

<Layout title="Experience - PT. PROMATCON TEPATGUNA">
  <Header />
  <main class="mx-auto w-full max-w-[1440px] flex-grow px-4 py-12 md:px-16">
    <!-- Header Section -->
    <div class="mb-8 text-center">
      <h1
        class="text-base-content mb-2 text-4xl font-semibold tracking-tight md:text-5xl"
      >
        {t("experience.title")}
      </h1>
      <p class="text-base-content/70 mx-auto max-w-3xl text-lg">
        {t("experience.subtitle")}
      </p>
    </div>

    <!-- Featured Project Cards Grid -->
    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        featuredProjects.map((project) => (
          <div class="bg-base-200/50 border-base-300 flex flex-col space-y-4 rounded-lg border p-6">
            <div class="flex items-center gap-4">
              <div class="bg-base-100 border-base-300 flex h-16 w-16 flex-shrink-0 items-center justify-center rounded border p-2">
                <img
                  src={project.logoUrl}
                  alt={`${project.client} Logo`}
                  class="h-full w-full object-contain"
                />
              </div>
              <h3 class="text-base-content text-xl font-bold">
                {project.client}
              </h3>
            </div>

            <div class="space-y-3 pt-2">
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Project Description
                </span>
                <p class="text-base-content/80 text-sm font-medium">
                  {project.description}
                </p>
              </div>
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Time and Point of Delivery
                </span>
                <p class="text-base-content/80 text-sm font-medium">
                  {project.delivery}
                </p>
              </div>
              <div>
                <span class="text-primary block text-xs font-bold tracking-wider uppercase">
                  Contract No
                </span>
                <p class="text-base-content/60 font-mono text-xs">
                  {project.contract}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Certificate Section using Swiper -->
    <CertificateGallery client:load />

    <div class="mt-12">
      <ExperienceTable client:load data={experienceData} />
    </div>
  </main>
  <Footer />
</Layout>
