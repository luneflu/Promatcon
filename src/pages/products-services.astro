---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductsTabNav from '../components/products/ProductsTabNav.astro';
import ProductGallery from '../components/products/ProductGallery.astro';
---

<Layout title="Products & Services | PT. PROMATCON TEPATGUNA">
	<Header />
	
	<main class="flex-grow pt-32 pb-24">
		<div class="max-w-[1440px] mx-auto px-4 md:px-16">
			<!-- Page Header -->
			<div class="text-center mb-10">
				<h1 class="text-4xl md:text-5xl font-semibold text-base-content mb-2 tracking-tight">Our Solutions & Products</h1>
				<p class="text-lg text-base-content/70 max-w-2xl mx-auto">
					Precision engineering and advanced systems tailored for complex industrial challenges.
				</p>
			</div>

			<ProductsTabNav />
			<ProductGallery />

		</div>
	</main>
	
	<Footer />
</Layout>