---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductGallery from "../components/products/ProductGallery.svelte";
import { useTranslations } from "../i18n/ui";

import { getLocale } from "astro-i18n-aut";
import type { Lang } from "../i18n/ui";

const locale = getLocale(Astro.url) as Lang;
const t = useTranslations(locale);
---

<Layout title="Products & Services | PT. PROMATCON TEPATGUNA">
  <Header />

  <main class="flex-grow pt-12 pb-24">
    <div class="mx-auto max-w-[1440px] px-4 md:px-16">
      <!-- Page Header -->
      <div class="mb-10 text-center">
        <h1
          class="text-base-content mb-2 text-4xl font-semibold tracking-tight md:text-5xl"
        >
          {t("products.title")}
        </h1>
        <p class="text-base-content/70 mx-auto max-w-2xl text-lg">
          {t("products.subtitle")}
        </p>
      </div>

      <ProductGallery client:load locale={locale} />
    </div>
  </main>

  <Footer />
</Layout>
